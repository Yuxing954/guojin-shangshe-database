page {
  background: #faf9f6;
  color: #2c2c28;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: #fff;
  border: 1rpx solid #ecebe6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted { color: #8a8a83; font-size: 24rpx; }
.up { color: #c0392b; }
.down { color: #1e8449; }
.flat { color: #5a5a52; }
.center { text-align: center; }
.empty {
  text-align: center;
  color: #8a8a83;
  padding: 80rpx 0;
  font-size: 26rpx;
}
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #f4f1ea;
  color: #6b6b62;
  margin-right: 8rpx;
}
.row { display: flex; align-items: center; }
.spread { justify-content: space-between; }
.loading { text-align: center; color: #8a8a83; padding: 60rpx 0; font-size: 26rpx; }
