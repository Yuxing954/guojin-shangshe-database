.page-wrap { padding-bottom: 40rpx; }

.hero {
  padding: 48rpx 32rpx 24rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: #8a8a83;
  font-size: 24rpx;
}

.sector-grid {
  display: flex;
  flex-wrap: wrap;
}
.sector-item {
  width: 20%;
  text-align: center;
  padding: 16rpx 0;
}
.sector-icon { font-size: 44rpx; }
.sector-name {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: #5a5a52;
}

.val-table { width: 100%; }
.val-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f4f2ed;
}
.val-row:last-child { border-bottom: none; }
.val-head { color: #8a8a83; font-size: 24rpx; }
.c-name { flex: 2; }
.c-num { flex: 1; text-align: right; }
.code { font-size: 20rpx; margin-left: 8rpx; }

.mover-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f4f2ed;
  font-size: 26rpx;
}
.mover-row:last-child { border-bottom: none; }
.mover-chg { font-weight: 600; }

.min-item { padding: 12rpx 0; border-bottom: 1rpx solid #f4f2ed; }
.min-item:last-child { border-bottom: none; }
.min-title { font-size: 26rpx; margin-bottom: 4rpx; }

.footer {
  padding: 32rpx 24rpx;
}
