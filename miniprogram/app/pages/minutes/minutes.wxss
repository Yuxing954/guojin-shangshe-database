.search-bar { margin: 16rpx 24rpx 0; }
.search-input {
  background: #fff;
  border: 1rpx solid #ecebe6;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.m-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.m-muted { font-size: 24rpx; margin-bottom: 10rpx; }
.m-body {
  font-size: 24rpx;
  color: #5a5a52;
  word-break: break-all;
}
.dl {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dl-btn {
  color: #b03a2e;
  font-size: 24rpx;
}
.fav-btn {
  font-size: 24rpx;
  color: #5a5a52;
  padding: 4rpx 16rpx;
  border: 1rpx solid #ecebe6;
  border-radius: 24rpx;
}
.fav-on {
  color: #b03a2e;
  border-color: #b03a2e;
  background: rgba(176, 58, 46, 0.06);
}
