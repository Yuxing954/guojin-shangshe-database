<view class="page-wrap">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索纪要标题 / 板块 / 标的" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <view wx:if="{{loading}}" class="loading">正在拉取 GitHub 最新数据…</view>
  <view wx:elif="{{err}}" class="empty">加载失败：{{err}}</view>
  <view wx:elif="{{!shown.length}}" class="empty">暂无纪要</view>

  <block wx:else>
    <view class="card" wx:for="{{shown}}" wx:key="title">
      <view class="m-title">{{item.title}}</view>
      <view class="meta-row">
        <text class="badge">{{item.type}}</text>
        <text class="badge">{{item.sector}}</text>
        <text class="muted">{{item.date}}</text>
      </view>
      <view class="m-muted muted">相关标的：{{item.stocks || '——'}}</view>
      <view class="m-body">{{item.summary}}</view>
      <view class="dl row spread">
        <text class="fav-btn {{favKeys[item.favKey] ? 'fav-on' : ''}}" bindtap="onToggleFav" data-idx="{{index}}">{{favKeys[item.favKey] ? '已收藏' : '收藏'}}</text>
        <text class="dl-btn" bindtap="copyDownload" data-link="{{item.link}}">复制下载链接</text>
      </view>
    </view>
  </block>
</view>
