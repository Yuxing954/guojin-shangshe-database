.cat-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #faf9f6;
}
.cat-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #ecebe6;
  font-size: 26rpx;
  color: #5a5a52;
}
.cat-on {
  background: #2c2c28;
  color: #fff;
  border-color: #2c2c28;
}

.ind-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.ind-name { font-size: 30rpx; font-weight: 600; }
.ind-unit { margin-bottom: 12rpx; }

.latest-row {
  display: flex;
  background: #f8f6f1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.latest-cell { flex: 1; }
.latest-cell.right { text-align: right; }
.small { font-size: 22rpx; }
.latest-val { font-size: 36rpx; font-weight: 700; margin-top: 4rpx; }

.pt-list { margin-top: 4rpx; }
.pt-row {
  display: flex;
  font-size: 24rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #f4f2ed;
}
.pt-row:last-child { border-bottom: none; }
.pt-d { flex: 2; color: #5a5a52; }
.pt-v { flex: 1; text-align: right; }
.pt-y { flex: 1; text-align: right; }
