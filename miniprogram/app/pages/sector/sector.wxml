<view class="page-wrap">
  <view wx:if="{{loading}}" class="loading">正在拉取 GitHub 最新数据…</view>
  <view wx:elif="{{err}}" class="empty">加载失败：{{err}}</view>

  <block wx:else>
    <!-- 分类切换 -->
    <scroll-view scroll-x class="cat-bar">
      <view class="cat-item {{currentCat === item ? 'cat-on' : ''}}"
            wx:for="{{categories}}" wx:key="*this"
            bindtap="switchCat" data-cat="{{item}}">{{item}}</view>
    </scroll-view>

    <view wx:if="{{!indicators.length}}" class="empty">该分类暂无指标</view>

    <view class="card" wx:for="{{indicators}}" wx:key="指标" wx:for-item="ind">
      <view class="ind-head">
        <view class="ind-name">{{ind.指标}}</view>
        <view class="badge">{{ind.频率}}</view>
      </view>
      <view class="ind-unit muted">单位：{{ind.单位 || '——'}}</view>

      <view class="latest-row" wx:if="{{ind.latest}}">
        <view class="latest-cell">
          <view class="muted small">最新值（{{ind.latest.d}}）</view>
          <view class="latest-val">{{ind.latest.v}}</view>
        </view>
        <view class="latest-cell right" wx:if="{{ind.latest.yoy !== null}}">
          <view class="muted small">同比</view>
          <view class="latest-val" style="color:{{ind.latest.yoy > 0 ? '#c0392b' : ind.latest.yoy < 0 ? '#1e8449' : '#5a5a52'}}">
            {{ind.latest.yoy > 0 ? '+' : ''}}{{ind.latest.yoy}}%
          </view>
        </view>
      </view>

      <view class="pt-list">
        <view class="pt-row" wx:for="{{ind.recent}}" wx:key="d" wx:for-item="pt">
          <text class="pt-d">{{pt.d}}</text>
          <text class="pt-v">{{pt.v}}</text>
          <text class="pt-y" style="color:{{pt.yoy > 0 ? '#c0392b' : pt.yoy < 0 ? '#1e8449' : '#8a8a83'}}">{{pt.yoy !== null ? (pt.yoy > 0 ? '+' : '') + pt.yoy + '%' : ''}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
