<view class="page-wrap">
  <!-- 页签：商社精选 / 全部 -->
  <view class="seg">
    <view class="seg-item {{tab === 'views' ? 'seg-on' : ''}}" bindtap="switchTab" data-tab="views">商社精选</view>
    <view class="seg-item {{tab === 'allviews' ? 'seg-on' : ''}}" bindtap="switchTab" data-tab="allviews">全部观点</view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索标题 / 内容 / 作者" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">清除</text>
  </view>

  <view wx:if="{{loading}}" class="loading">正在拉取 GitHub 最新数据…</view>
  <view wx:elif="{{err}}" class="empty">加载失败：{{err}}</view>
  <view wx:elif="{{!shown.length}}" class="empty">无匹配观点</view>

  <block wx:else>
    <view class="muted total-bar">共 {{total}} 条 · 覆盖至 {{coverageTo || '——'}}</view>
    <view class="card view-card" wx:for="{{shown}}" wx:key="index">
      <view class="v-title">{{item.title || '(无标题)'}}</view>
      <view class="v-meta muted">
        <text wx:if="{{item.author}}">{{item.author}} · </text>
        <text>{{item.t}}</text>
      </view>
      <view class="v-body" wx:if="{{item.body}}">{{item.body}}</view>
      <view class="v-foot row spread">
        <view class="muted small">
          <text wx:if="{{item.likes}}">赞 {{item.likes}} </text>
          <text wx:if="{{item.comments}}">评 {{item.comments}} </text>
          <text wx:if="{{item.reads}}">阅 {{item.reads}}</text>
        </view>
        <view class="row">
          <text class="fav-btn {{favKeys[item.favKey] ? 'fav-on' : ''}}" bindtap="onToggleFav" data-idx="{{index}}">{{favKeys[item.favKey] ? '已收藏' : '收藏'}}</text>
          <text wx:if="{{item.link}}" class="copy-btn" bindtap="copyLink" data-link="{{item.link}}">复制原文链接</text>
        </view>
      </view>
    </view>
    <view class="load-tip muted center" wx:if="{{shown.length < list.length}}">上拉加载更多…</view>
  </block>
</view>
