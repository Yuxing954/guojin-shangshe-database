.seg {
  display: flex;
  background: #ecebe6;
  border-radius: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #5a5a52;
}
.seg-on {
  background: #fff;
  color: #2c2c28;
  font-weight: 600;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
}
.search-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #ecebe6;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}
.search-clear {
  margin-left: 16rpx;
  color: #8a8a83;
  font-size: 24rpx;
}

.total-bar { padding: 16rpx 32rpx 0; }

.view-card { padding: 24rpx; }
.v-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.v-meta { margin-bottom: 10rpx; font-size: 22rpx; }
.v-body {
  font-size: 24rpx;
  color: #5a5a52;
  word-break: break-all;
  max-height: 300rpx;
  overflow: hidden;
}
.copy-btn {
  color: #b03a2e;
  font-size: 24rpx;
}
.fav-btn {
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #5a5a52;
  padding: 4rpx 16rpx;
  border: 1rpx solid #ecebe6;
  border-radius: 24rpx;
}
.fav-on {
  color: #b03a2e;
  border-color: #b03a2e;
  background: rgba(176, 58, 46, 0.06);
}
.load-tip { padding: 24rpx 0 48rpx; }
