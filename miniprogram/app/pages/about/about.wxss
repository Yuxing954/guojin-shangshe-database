.p {
  font-size: 26rpx;
  margin-bottom: 10rpx;
  word-break: break-all;
}
.link-row {
  font-size: 26rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f4f2ed;
  color: #b03a2e;
}
.link-row:last-child { border-bottom: none; }
.foot { padding: 40rpx 0; }

.login-btn {
  background: #b03a2e;
  color: #fff;
  font-size: 28rpx;
  margin: 12rpx 0 6rpx;
  border-radius: 12rpx;
}
.err-text { color: #b03a2e; font-size: 24rpx; }
.fav-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f2ed;
}
.fav-item:last-child { border-bottom: none; }
.fav-title {
  font-size: 26rpx;
  font-weight: 600;
  margin: 6rpx 0 8rpx;
  word-break: break-all;
}
.fav-head { margin-top: 4rpx; }
.copy-btn { color: #b03a2e; font-size: 24rpx; }
.badge {
  font-size: 20rpx;
  color: #b03a2e;
  background: rgba(176, 58, 46, 0.08);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.row { display: flex; align-items: center; }
.spread { justify-content: space-between; }
.small { font-size: 22rpx; }
.muted { color: #8a8a83; }
